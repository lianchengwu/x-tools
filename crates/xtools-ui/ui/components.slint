import { Theme } from "theme.slint";
export { Theme } from "theme.slint";
import { TextEdit, ScrollView } from "std-widgets.slint";

export component ActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> is-primary: false;
    in property <length> min-btn-width: 68px;
    callback clicked();

    min-width: root.min-btn-width;
    height: Theme.control-height;
    border-radius: Theme.radius-control;
    border-width: root.is-primary ? 0px : 1px;
    border-color: !root.enabled ? Theme.border-subtle : (touch.has-hover ? Theme.border-hover : Theme.border);
    background: !root.enabled 
        ? (root.is-primary ? Theme.primary-disabled : Theme.background)
        : (root.is-primary 
            ? (touch.pressed ? Theme.primary-active : (touch.has-hover ? Theme.primary-hover : Theme.primary))
            : (touch.pressed ? Theme.secondary-active : (touch.has-hover ? Theme.secondary-hover : Theme.secondary)));

    animate background { duration: 100ms; }
    animate border-color { duration: 100ms; }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        alignment: center;
        Text {
            text: root.text;
            font-size: Theme.font-size-body;
            font-weight: root.is-primary ? 600 : 500;
            color: !root.enabled 
                ? (root.is-primary ? Theme.primary-fg : Theme.muted)
                : (root.is-primary ? Theme.primary-fg : Theme.foreground);
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component CopyButton inherits Rectangle {
    in property <bool> copied: false;
    in property <bool> enabled: true;
    in property <length> min-btn-width: 68px;
    callback clicked();

    min-width: root.min-btn-width;
    height: Theme.control-height;
    border-radius: Theme.radius-control;
    border-width: 1px;
    border-color: root.copied 
        ? Theme.success-border 
        : (!root.enabled ? Theme.border-subtle : (touch.has-hover ? Theme.border-hover : Theme.border));
    background: root.copied 
        ? Theme.success-bg 
        : (!root.enabled ? Theme.background : (touch.pressed ? Theme.secondary-active : (touch.has-hover ? Theme.secondary-hover : Theme.secondary)));

    animate background { duration: 120ms; }
    animate border-color { duration: 120ms; }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        alignment: center;
        spacing: 4px;

        if root.copied : Text {
            text: "✓";
            font-size: Theme.font-size-body;
            font-weight: 700;
            color: Theme.success;
            vertical-alignment: center;
        }

        Text {
            text: root.copied ? "已复制" : "复制";
            font-size: Theme.font-size-body;
            font-weight: root.copied ? 600 : 500;
            color: root.copied ? Theme.success : (!root.enabled ? Theme.muted : Theme.foreground);
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <bool> enabled: true;
    callback clicked();

    width: Theme.control-height;
    height: Theme.control-height;
    border-radius: Theme.radius-control;
    border-width: 1px;
    border-color: !root.enabled ? Theme.border-subtle : (touch.has-hover ? Theme.border-hover : Theme.border);
    background: !root.enabled ? Theme.background : (touch.pressed ? Theme.secondary-active : (touch.has-hover ? Theme.secondary-hover : Theme.secondary));

    animate background { duration: 100ms; }
    animate border-color { duration: 100ms; }

    Text {
        text: root.icon;
        font-size: Theme.font-size-body;
        font-weight: 600;
        color: !root.enabled ? Theme.muted : Theme.foreground;
        vertical-alignment: center;
        horizontal-alignment: center;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component ValueInput inherits Rectangle {
    in-out property <string> text;
    in property <bool> enabled: true;
    in property <bool> read-only: false;
    in property <string> placeholder: "";
    callback edited(string);
    callback accepted(string);

    height: Theme.control-height;
    border-radius: Theme.radius-control;
    border-width: input.has-focus ? 1.5px : 1px;
    border-color: input.has-focus ? Theme.primary : (touch.has-hover ? Theme.border-hover : Theme.border);
    background: Theme.card-bg;

    animate border-color { duration: 100ms; }

    touch := TouchArea {
        clicked => { input.focus(); }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;

        if root.text == "" && root.placeholder != "" && !input.has-focus : Text {
            text: root.placeholder;
            font-size: Theme.font-size-body;
            font-family: Theme.font-mono;
            color: Theme.muted;
            vertical-alignment: center;
        }

        input := TextInput {
            text <=> root.text;
            enabled: root.enabled;
            read-only: root.read-only;
            font-size: Theme.font-size-body;
            font-family: Theme.font-mono;
            color: Theme.foreground;
            selection-background-color: Theme.selection;
            selection-foreground-color: Theme.foreground;
            vertical-alignment: center;
            single-line: true;

            edited => { root.edited(self.text); }
            accepted => { root.accepted(self.text); }
        }
    }
}

export component FieldWithAction inherits VerticalLayout {
    in property <string> caption;
    in-out property <string> text;
    in property <string> action-text;
    in property <bool> action-enabled: true;
    in property <bool> action-copied: false;
    in property <bool> is-copy: false;
    in property <bool> is-primary: false;
    callback action-clicked();
    callback edited(string);
    callback accepted(string);

    spacing: 5px;

    if root.caption != "" : Text {
        text: root.caption;
        font-size: Theme.font-size-small;
        font-weight: 600;
        color: Theme.muted;
    }

    HorizontalLayout {
        spacing: 8px;
        alignment: stretch;

        ValueInput {
            text <=> root.text;
            horizontal-stretch: 1;
            edited(t) => { root.edited(t); }
            accepted(t) => { root.accepted(t); }
        }

        if root.is-copy : CopyButton {
            copied: root.action-copied;
            enabled: root.action-enabled;
            clicked => { root.action-clicked(); }
        }

        if !root.is-copy : ActionButton {
            text: root.action-text;
            enabled: root.action-enabled;
            is-primary: root.is-primary;
            clicked => { root.action-clicked(); }
        }
    }
}

export component MultilineEditor inherits Rectangle {
    in-out property <string> text;
    in property <bool> enabled: true;
    in property <bool> read-only: false;
    callback edited(string);

    border-radius: Theme.radius-control;
    border-width: editor.has-focus ? 1.5px : 1px;
    border-color: editor.has-focus ? Theme.primary : Theme.border;
    background: Theme.card-bg;

    animate border-color { duration: 100ms; }

    HorizontalLayout {
        padding: 10px;
        editor := TextEdit {
            text <=> root.text;
            enabled: root.enabled;
            read-only: root.read-only;
            font-size: Theme.font-size-body;
            font-family: Theme.font-mono;
            edited => { root.edited(self.text); }
        }
    }
}

export component InlineError inherits Rectangle {
    in property <string> error-text;

    border-radius: Theme.radius-control;
    border-width: 1px;
    border-color: Theme.error-border;
    background: Theme.error-bg;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 8px;
        alignment: start;

        Text {
            text: "⚠️";
            font-size: Theme.font-size-small;
            vertical-alignment: top;
        }

        Text {
            text: root.error-text;
            font-size: Theme.font-size-small;
            font-weight: 500;
            color: Theme.error-fg;
            wrap: word-wrap;
            vertical-alignment: top;
            horizontal-stretch: 1;
        }
    }
}

export component InlineNote inherits HorizontalLayout {
    in property <string> text;
    spacing: 4px;
    alignment: start;

    Text {
        text: root.text;
        font-size: Theme.font-size-small;
        font-weight: 500;
        color: Theme.muted;
        vertical-alignment: center;
    }
}

export component DropdownPopup inherits Rectangle {
    in property <[string]> options;
    in property <int> selected-index: 0;
    callback selected(int);

    border-radius: Theme.radius-control;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.card-bg;
    drop-shadow-blur: 16px;
    drop-shadow-color: Theme.drop-shadow;
    drop-shadow-offset-y: 4px;
    height: min(260px, max(68px, root.options.length * 32px + 10px));
    ScrollView {
        VerticalLayout {
            padding: 4px;
            spacing: 2px;

            for opt[idx] in root.options : Rectangle {
                height: 30px;
                border-radius: 6px;
                background: item-touch.has-hover ? Theme.secondary-hover : (idx == root.selected-index ? Theme.secondary : Colors.transparent);

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    alignment: start;
                    Text {
                        text: opt;
                        font-size: Theme.font-size-body;
                        font-weight: idx == root.selected-index ? 600 : 400;
                        color: idx == root.selected-index ? Theme.primary : Theme.foreground;
                        vertical-alignment: center;
                    }
                }

                item-touch := TouchArea {
                    clicked => {
                        root.selected(idx);
                    }
                }
            }
        }
    }
}

export component DropdownSelector inherits Rectangle {
    in property <string> label: "";
    in property <[string]> options;
    in-out property <int> selected-index: 0;
    in property <length> selector-width: 112px;
    callback selection-changed(int);

    width: root.selector-width;
    height: Theme.control-height;
    border-radius: Theme.radius-control;
    border-width: 1px;
    border-color: popup-area.has-hover ? Theme.border-hover : Theme.border;
    background: popup-area.has-hover ? Theme.secondary-hover : Theme.secondary;

    animate background { duration: 100ms; }
    animate border-color { duration: 100ms; }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 4px;
        alignment: space-between;

        if root.label != "" : Text {
            text: root.label;
            font-size: Theme.font-size-small;
            font-weight: 500;
            color: Theme.muted;
            vertical-alignment: center;
        }

        Text {
            text: root.options[root.selected-index];
            font-size: Theme.font-size-body;
            font-weight: 500;
            color: Theme.foreground;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        Text {
            text: "▾";
            font-size: 11px;
            color: Theme.muted;
            vertical-alignment: center;
        }
    }

    popup-area := TouchArea {
        clicked => {
            popup.show();
        }
    }

    popup := PopupWindow {
        x: 0px;
        y: root.height + 4px;
        width: root.width;
        height: min(260px, max(68px, root.options.length * 32px + 10px));

        DropdownPopup {
            width: 100%;
            height: 100%;
            options: root.options;
            selected-index: root.selected-index;
            selected(idx) => {
                root.selected-index = idx;
                root.selection-changed(idx);
                popup.close();
            }
        }
    }
}

export component ToolShell inherits Rectangle {
    in property <string> title;
    in property <string> icon: "";
    in property <bool> resizable: false;
    in property <bool> show-expand-button: false;
    in property <bool> is-expanded: false;
    callback close-clicked();
    callback expand-clicked();
    callback window-drag-started();
    callback window-dragged(length, length);
    callback window-resize-started(int);
    callback window-resized(length, length);

    border-radius: Theme.radius-card;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.background;
    clip: true;

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // Titlebar Header
        Rectangle {
            height: Theme.titlebar-height;
            background: Theme.card-bg;

            // Drag region
            TouchArea {
                x: 0px;
                y: 0px;
                width: parent.width - (root.show-expand-button ? 74px : 44px);
                height: parent.height;
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                        root.window-drag-started();
                    }
                }
                moved => {
                    root.window-dragged(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
                }
            }

            // Title & Icon
            HorizontalLayout {
                x: 18px;
                y: 0px;
                width: parent.width - (root.show-expand-button ? 96px : 64px);
                height: parent.height;
                spacing: 8px;
                alignment: start;

                if root.icon != "" : Text {
                    text: root.icon;
                    font-size: 16px;
                    vertical-alignment: center;
                }

                Text {
                    text: root.title;
                    font-size: Theme.font-size-title;
                    font-weight: 600;
                    color: Theme.foreground;
                    vertical-alignment: center;
                }
            }

            // Expand / Maximize button (optional)
            if root.show-expand-button : Rectangle {
                x: parent.width - 66px;
                y: (parent.height - 26px) / 2;
                width: 26px;
                height: 26px;
                border-radius: 13px;
                background: expand-touch.pressed
                    ? Theme.secondary-hover
                    : (expand-touch.has-hover ? Theme.secondary : Colors.transparent);

                animate background { duration: 100ms; }

                Path {
                    width: 10px;
                    height: 10px;
                    x: (parent.width - 10px) / 2;
                    y: (parent.height - 10px) / 2;
                    commands: root.is-expanded
                        ? "M 1 4 L 4 4 L 4 1 M 9 6 L 6 6 L 6 9 M 4 4 L 1 1 M 6 6 L 9 9"
                        : "M 4 1 L 1 1 L 1 4 M 6 9 L 9 9 L 9 6 M 1 1 L 4 4 M 9 9 L 6 6";
                    stroke: expand-touch.has-hover ? Theme.foreground : Theme.muted;
                    stroke-width: 1.2px;
                }

                expand-touch := TouchArea {
                    clicked => {
                        root.expand-clicked();
                    }
                }
            }

            // Close button (macOS / Modern style)
            Rectangle {
                x: parent.width - 36px;
                y: (parent.height - 26px) / 2;
                width: 26px;
                height: 26px;
                border-radius: 13px;
                background: close-touch.pressed 
                    ? Theme.error-border
                    : (close-touch.has-hover ? Theme.secondary : Colors.transparent);

                animate background { duration: 100ms; }

                Path {
                    width: 10px;
                    height: 10px;
                    x: (parent.width - 10px) / 2;
                    y: (parent.height - 10px) / 2;
                    commands: "M 1.5 1.5 L 8.5 8.5 M 8.5 1.5 L 1.5 8.5";
                    stroke: close-touch.has-hover ? (close-touch.pressed ? Theme.error-fg : Theme.foreground-soft) : Theme.muted;
                    stroke-width: 1.5px;
                }
                close-touch := TouchArea {
                    clicked => {
                        root.close-clicked();
                    }
                }
            }

            // Subtle divider line
            Rectangle {
                x: 0px;
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                background: Theme.border-subtle;
            }
        }

        // Main content area
        VerticalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 18px;
            padding-bottom: 18px;
            alignment: stretch;
            vertical-stretch: 1;

            @children
        }
    }

    // Right edge resize handle
    if root.resizable : TouchArea {
        x: parent.width - 8px;
        y: Theme.titlebar-height;
        width: 8px;
        height: parent.height - Theme.titlebar-height - 14px;
        mouse-cursor: ew-resize;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                root.window-resize-started(1);
            }
        }
        moved => {
            root.window-resized(self.mouse-x - self.pressed-x, 0px);
        }
    }

    // Bottom edge resize handle
    if root.resizable : TouchArea {
        x: 0px;
        y: parent.height - 8px;
        width: parent.width - 14px;
        height: 8px;
        mouse-cursor: ns-resize;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                root.window-resize-started(2);
            }
        }
        moved => {
            root.window-resized(0px, self.mouse-y - self.pressed-y);
        }
    }

    // Bottom-right corner resize handle
    if root.resizable : TouchArea {
        x: parent.width - 18px;
        y: parent.height - 18px;
        width: 18px;
        height: 18px;
        mouse-cursor: nwse-resize;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                root.window-resize-started(3);
            }
        }
        moved => {
            root.window-resized(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
        }
    }

    // Visual grip dots in bottom-right corner
    if root.resizable : Rectangle {
        x: parent.width - 12px;
        y: parent.height - 12px;
        width: 8px;
        height: 8px;

        Rectangle {
            x: 5px;
            y: 5px;
            width: 2px;
            height: 2px;
            border-radius: 1px;
            background: Theme.muted;
        }
        Rectangle {
            x: 1px;
            y: 5px;
            width: 2px;
            height: 2px;
            border-radius: 1px;
            background: Theme.muted;
        }
        Rectangle {
            x: 5px;
            y: 1px;
            width: 2px;
            height: 2px;
            border-radius: 1px;
            background: Theme.muted;
        }
    }
}
