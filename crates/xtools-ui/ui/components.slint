import { Theme } from "theme.slint";
export { Theme } from "theme.slint";
import { TextEdit, ScrollView } from "std-widgets.slint";

export component ActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> is-primary: false;
    in property <string> variant: "default"; // "default", "primary", "success", "danger"
    in property <length> min-btn-width: 68px;
    // 允许调用方覆盖高度（默认标准控件高度）
    in property <length> btn-height: Theme.control-height;
    callback clicked();

    min-width: root.min-btn-width;
    height: root.btn-height;
    border-radius: Theme.radius-control;
    border-width: (root.is-primary || root.variant == "primary" || root.variant == "success" || root.variant == "danger") ? 0px : 1px;
    border-color: !root.enabled ? Theme.border-subtle : (touch.has-hover ? Theme.border-hover : Theme.border);
    background: !root.enabled 
        ? ((root.is-primary || root.variant == "primary") ? Theme.primary-disabled : (root.variant == "success" ? Theme.border : (root.variant == "danger" ? Theme.border : Theme.background)))
        : (root.variant == "success"
            ? (touch.pressed ? Theme.success-active : (touch.has-hover ? Theme.success-hover : Theme.success))
            : (root.variant == "danger"
                ? (touch.pressed ? Theme.danger-active : (touch.has-hover ? Theme.danger-hover : Theme.danger))
                : ((root.is-primary || root.variant == "primary") 
                    ? (touch.pressed ? Theme.primary-active : (touch.has-hover ? Theme.primary-hover : Theme.primary))
                    : (touch.pressed ? Theme.secondary-active : (touch.has-hover ? Theme.secondary-hover : Theme.secondary)))));

    animate background { duration: 100ms; }
    animate border-color { duration: 100ms; }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        alignment: center;
        Text {
            text: root.text;
            font-size: Theme.font-size-body;
            font-weight: (root.is-primary || root.variant != "default") ? 600 : 500;
            color: !root.enabled 
                ? ((root.is-primary || root.variant != "default") ? Theme.primary-fg : Theme.muted)
                : ((root.is-primary || root.variant != "default") ? Theme.primary-fg : Theme.foreground);
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component CopyButton inherits Rectangle {
    in property <bool> copied: false;
    in property <bool> enabled: true;
    in property <length> min-btn-width: 68px;
    callback clicked();

    min-width: root.min-btn-width;
    height: Theme.control-height;
    border-radius: Theme.radius-control;
    border-width: 1px;
    border-color: root.copied 
        ? Theme.success-border 
        : (!root.enabled ? Theme.border-subtle : (touch.has-hover ? Theme.border-hover : Theme.border));
    background: root.copied 
        ? Theme.success-bg 
        : (!root.enabled ? Theme.background : (touch.pressed ? Theme.secondary-active : (touch.has-hover ? Theme.secondary-hover : Theme.secondary)));

    animate background { duration: 120ms; }
    animate border-color { duration: 120ms; }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        alignment: center;
        spacing: 4px;

        if root.copied : VerticalLayout {
            alignment: center;
            Path {
                width: 10px;
                height: 8px;
                commands: "M 1 4 L 3.5 6.5 L 9 1";
                stroke: Theme.success;
                stroke-width: 1.8px;
                stroke-line-cap: round;
                stroke-line-join: round;
            }
        }

        Text {
            text: root.copied ? "已复制" : "复制";
            font-size: Theme.font-size-body;
            font-weight: root.copied ? 600 : 500;
            color: root.copied ? Theme.success : (!root.enabled ? Theme.muted : Theme.foreground);
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component IconButton inherits Rectangle {
    in property <string> icon: "";
    in property <bool> enabled: true;
    callback clicked();

    width: Theme.control-height;
    height: Theme.control-height;
    border-radius: Theme.radius-control;
    border-width: 1px;
    border-color: !root.enabled ? Theme.border-subtle : (touch.has-hover ? Theme.border-hover : Theme.border);
    background: !root.enabled ? Theme.background : (touch.pressed ? Theme.secondary-active : (touch.has-hover ? Theme.secondary-hover : Theme.secondary));

    animate background { duration: 100ms; }
    animate border-color { duration: 100ms; }

    property <bool> is-swap: root.icon == "⇄" || root.icon == "swap";
    property <bool> is-plus: root.icon == "＋" || root.icon == "+" || root.icon == "plus" || root.icon == "➕";
    property <bool> is-copy: root.icon == "📋" || root.icon == "copy";
    property <bool> is-trash: root.icon == "🗑" || root.icon == "trash" || root.icon == "delete";
    property <bool> is-vector: root.is-swap || root.is-plus || root.is-copy || root.is-trash;

    property <color> icon-color: !root.enabled ? Theme.muted : (touch.has-hover ? Theme.foreground : Theme.foreground-soft);

    if root.is-swap : Path {
        width: 14px;
        height: 12px;
        x: (parent.width - 14px) / 2;
        y: (parent.height - 12px) / 2;
        commands: "M 2 3.5 L 12 3.5 M 8.5 1 L 12 3.5 L 8.5 6 M 12 8.5 L 2 8.5 M 5.5 6 L 2 8.5 L 5.5 11";
        stroke: root.icon-color;
        stroke-width: 1.5px;
        stroke-line-cap: round;
        stroke-line-join: round;
    }

    if root.is-plus : Path {
        width: 12px;
        height: 12px;
        x: (parent.width - 12px) / 2;
        y: (parent.height - 12px) / 2;
        commands: "M 1 6 L 11 6 M 6 1 L 6 11";
        stroke: root.icon-color;
        stroke-width: 1.6px;
        stroke-line-cap: round;
        stroke-line-join: round;
    }

    if root.is-copy : Path {
        width: 13px;
        height: 13px;
        x: (parent.width - 13px) / 2;
        y: (parent.height - 13px) / 2;
        commands: "M 4.5 2.5 L 4.5 1 L 11.5 1 L 11.5 8 L 10 8 M 1 4 L 8.5 4 L 8.5 11.5 L 1 11.5 Z";
        stroke: root.icon-color;
        stroke-width: 1.3px;
        stroke-line-cap: round;
        stroke-line-join: round;
    }

    if root.is-trash : Path {
        width: 13px;
        height: 13px;
        x: (parent.width - 13px) / 2;
        y: (parent.height - 13px) / 2;
        commands: "M 1.5 3.5 L 11.5 3.5 M 4.5 3.5 L 4.5 1.5 L 8.5 1.5 L 8.5 3.5 M 2.5 3.5 L 3 11.5 L 10 11.5 L 10.5 3.5 M 5 5.5 L 5 9.5 M 8 5.5 L 8 9.5";
        stroke: root.icon-color;
        stroke-width: 1.2px;
        stroke-line-cap: round;
        stroke-line-join: round;
    }

    if !root.is-vector && root.icon != "" : Text {
        text: root.icon;
        font-size: Theme.font-size-body;
        font-weight: 600;
        color: !root.enabled ? Theme.muted : Theme.foreground;
        vertical-alignment: center;
        horizontal-alignment: center;
    }

    @children

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component ValueInput inherits Rectangle {
    in-out property <string> text;
    in property <bool> enabled: true;
    in property <bool> read-only: false;
    in property <string> placeholder: "";
    callback edited(string);
    callback accepted(string);

    height: Theme.control-height;
    border-radius: Theme.radius-control;
    border-width: input.has-focus ? 1.5px : 1px;
    border-color: input.has-focus ? Theme.primary : (touch.has-hover ? Theme.border-hover : Theme.border);
    background: Theme.card-bg;

    animate border-color { duration: 100ms; }

    touch := TouchArea {
        clicked => { input.focus(); }
    }

    // 绝对定位 + 固定占满：宽度只由父级布局决定，不随输入内容增长
    if root.text == "" && root.placeholder != "" && !input.has-focus : Text {
        x: 10px;
        width: parent.width - 20px;
        text: root.placeholder;
        font-size: Theme.font-size-body;
        font-family: Theme.font-mono;
        color: Theme.muted;
        vertical-alignment: center;
        overflow: elide;
    }

    input := TextInput {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        text <=> root.text;
        enabled: root.enabled;
        read-only: root.read-only;
        font-size: Theme.font-size-body;
        font-family: Theme.font-mono;
        color: Theme.foreground;
        selection-background-color: Theme.selection;
        selection-foreground-color: Theme.foreground;
        vertical-alignment: center;
        single-line: true;

        edited => { root.edited(self.text); }
        accepted => { root.accepted(self.text); }
    }
}

export component FieldWithAction inherits VerticalLayout {
    in property <string> caption;
    in-out property <string> text;
    in property <string> action-text;
    in property <bool> action-enabled: true;
    in property <bool> action-copied: false;
    in property <bool> is-copy: false;
    in property <bool> is-primary: false;
    callback action-clicked();
    callback edited(string);
    callback accepted(string);

    spacing: 5px;

    if root.caption != "" : Text {
        text: root.caption;
        font-size: Theme.font-size-small;
        font-weight: 600;
        color: Theme.muted;
    }

    HorizontalLayout {
        spacing: 8px;
        alignment: stretch;

        ValueInput {
            text <=> root.text;
            horizontal-stretch: 1;
            edited(t) => { root.edited(t); }
            accepted(t) => { root.accepted(t); }
        }

        if root.is-copy : CopyButton {
            copied: root.action-copied;
            enabled: root.action-enabled;
            clicked => { root.action-clicked(); }
        }

        if !root.is-copy : ActionButton {
            text: root.action-text;
            enabled: root.action-enabled;
            is-primary: root.is-primary;
            clicked => { root.action-clicked(); }
        }
    }
}

export component MultilineEditor inherits Rectangle {
    in-out property <string> text;
    in property <bool> enabled: true;
    in property <bool> read-only: false;
    // 为 true 时按 Enter 触发 accepted（Shift+Enter 仍换行）；默认关闭，Enter 正常换行
    in property <bool> enter-sends: false;
    callback edited(string);
    callback accepted(string);

    border-radius: Theme.radius-control;
    border-width: editor.has-focus ? 1.5px : 1px;
    border-color: editor.has-focus ? Theme.primary : Theme.border;
    background: Theme.card-bg;

    animate border-color { duration: 100ms; }

    HorizontalLayout {
        padding: 10px;
        editor := TextEdit {
            text <=> root.text;
            enabled: root.enabled;
            read-only: root.read-only;
            font-size: Theme.font-size-body;
            font-family: Theme.font-mono;
            edited => { root.edited(self.text); }
            key-pressed(event) => {
                if (root.enter-sends && event.text == "\n" && !event.modifiers.shift) {
                    root.accepted(self.text);
                    accept
                } else {
                    reject
                }
            }
        }
    }
}

export component InlineError inherits Rectangle {
    in property <string> error-text;

    border-radius: Theme.radius-control;
    border-width: 1px;
    border-color: Theme.error-border;
    background: Theme.error-bg;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 8px;
        alignment: start;

        VerticalLayout {
            alignment: start;
            padding-top: 2px;
            Path {
                width: 13px;
                height: 12px;
                commands: "M 6.5 1 L 12.5 11.5 L 0.5 11.5 Z M 6.5 4.5 L 6.5 7.5 M 6.5 9.5 L 6.5 10";
                stroke: Theme.error-fg;
                stroke-width: 1.2px;
                stroke-line-cap: round;
                stroke-line-join: round;
            }
        }

        Text {
            text: root.error-text;
            font-size: Theme.font-size-small;
            font-weight: 500;
            color: Theme.error-fg;
            wrap: word-wrap;
            vertical-alignment: top;
            horizontal-stretch: 1;
        }
    }
}

export component InlineNote inherits HorizontalLayout {
    in property <string> text;
    spacing: 4px;
    alignment: start;

    Text {
        text: root.text;
        font-size: Theme.font-size-small;
        font-weight: 500;
        color: Theme.muted;
        vertical-alignment: center;
    }
}

export component DropdownPopup inherits Rectangle {
    in property <[string]> options;
    in property <int> selected-index: 0;
    callback selected(int);

    border-radius: Theme.radius-control;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.card-bg;
    drop-shadow-blur: 16px;
    drop-shadow-color: Theme.drop-shadow;
    drop-shadow-offset-y: 4px;
    // 弹层高度随选项数自适应：每项 30px + 项间 2px + 上下 4px 内边距，避免出现空白行
    height: min(260px, max(38px, root.options.length * 32px + 6px));
    ScrollView {
        VerticalLayout {
            padding: 4px;
            spacing: 2px;

            for opt[idx] in root.options : Rectangle {
                height: 30px;
                border-radius: 6px;
                background: item-touch.has-hover ? Theme.secondary-hover : (idx == root.selected-index ? Theme.secondary : Colors.transparent);

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    alignment: start;
                    Text {
                        text: opt;
                        font-size: Theme.font-size-body;
                        font-weight: idx == root.selected-index ? 600 : 400;
                        color: idx == root.selected-index ? Theme.primary : Theme.foreground;
                        vertical-alignment: center;
                    }
                }

                item-touch := TouchArea {
                    clicked => {
                        root.selected(idx);
                    }
                }
            }
        }
    }
}

export component DropdownSelector inherits Rectangle {
    in property <string> label: "";
    in property <[string]> options;
    in-out property <int> selected-index: 0;
    in property <length> selector-width: 112px;
    // 允许调用方覆盖高度（默认标准控件高度）
    in property <length> selector-height: Theme.control-height;
    // 为 true 时下拉列表向上弹出（用于靠近窗口底部的场景）
    in property <bool> open-up: false;
    callback selection-changed(int);

    width: root.selector-width;
    height: root.selector-height;
    border-radius: Theme.radius-control;
    border-width: 1px;
    border-color: popup-area.has-hover ? Theme.border-hover : Theme.border;
    background: popup-area.has-hover ? Theme.secondary-hover : Theme.secondary;

    animate background { duration: 100ms; }
    animate border-color { duration: 100ms; }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 4px;
        alignment: space-between;

        if root.label != "" : Text {
            text: root.label;
            font-size: Theme.font-size-small;
            font-weight: 500;
            color: Theme.muted;
            vertical-alignment: center;
        }

        Text {
            text: root.options[root.selected-index];
            font-size: Theme.font-size-body;
            font-weight: 500;
            color: Theme.foreground;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        VerticalLayout {
            alignment: center;
            width: 8px;
            Path {
                width: 8px;
                height: 5px;
                commands: "M 0.5 1 L 4 4.5 L 7.5 1";
                stroke: popup-area.has-hover ? Theme.foreground-soft : Theme.muted;
                stroke-width: 1.5px;
                stroke-line-cap: round;
                stroke-line-join: round;
            }
        }
    }

    popup-area := TouchArea {
        clicked => {
            popup.show();
        }
    }

    // 弹层高度：与 DropdownPopup 内部公式保持一致（每项 32px 含间距 + 8px 内边距）
    property <length> popup-height: min(260px, max(38px, root.options.length * 32px + 6px));

    popup := PopupWindow {
        x: 0px;
        y: root.open-up
            ? -root.popup-height - 4px
            : root.height + 4px;
        width: root.width;
        height: root.popup-height;

        DropdownPopup {
            width: 100%;
            height: 100%;
            options: root.options;
            selected-index: root.selected-index;
            selected(idx) => {
                root.selected-index = idx;
                root.selection-changed(idx);
                popup.close();
            }
        }
    }
}

export component ToolShell inherits Rectangle {
    in property <string> title;
    in property <string> icon: "";
    in property <bool> resizable: false;
    in property <bool> show-expand-button: false;
    in property <bool> is-expanded: false;
    callback close-clicked();
    callback expand-clicked();
    callback window-drag-started();
    callback window-dragged(length, length);
    callback window-resize-started(int);
    callback window-resized(length, length);

    border-radius: Theme.radius-card;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.background;
    clip: true;

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // Titlebar Header
        Rectangle {
            height: Theme.titlebar-height;
            background: Theme.card-bg;

            // Drag region
            TouchArea {
                x: 0px;
                y: 0px;
                width: parent.width - (root.show-expand-button ? 74px : 44px);
                height: parent.height;
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                        root.window-drag-started();
                    }
                }
                moved => {
                    root.window-dragged(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
                }
            }

            // Title & Icon
            HorizontalLayout {
                x: 18px;
                y: 0px;
                width: parent.width - (root.show-expand-button ? 96px : 64px);
                height: parent.height;
                spacing: 8px;
                alignment: start;

                if root.icon != "" : Text {
                    text: root.icon;
                    font-size: 16px;
                    vertical-alignment: center;
                }

                Text {
                    text: root.title;
                    font-size: Theme.font-size-title;
                    font-weight: 600;
                    color: Theme.foreground;
                    vertical-alignment: center;
                }
            }

            // Expand / Maximize button (optional)
            if root.show-expand-button : Rectangle {
                x: parent.width - 66px;
                y: (parent.height - 26px) / 2;
                width: 26px;
                height: 26px;
                border-radius: 13px;
                background: expand-touch.pressed
                    ? Theme.secondary-hover
                    : (expand-touch.has-hover ? Theme.secondary : Colors.transparent);

                animate background { duration: 100ms; }

                Path {
                    width: 10px;
                    height: 10px;
                    x: (parent.width - 10px) / 2;
                    y: (parent.height - 10px) / 2;
                    commands: root.is-expanded
                        ? "M 1 4 L 4 4 L 4 1 M 9 6 L 6 6 L 6 9 M 4 4 L 1 1 M 6 6 L 9 9"
                        : "M 4 1 L 1 1 L 1 4 M 6 9 L 9 9 L 9 6 M 1 1 L 4 4 M 9 9 L 6 6";
                    stroke: expand-touch.has-hover ? Theme.foreground : Theme.muted;
                    stroke-width: 1.2px;
                }

                expand-touch := TouchArea {
                    clicked => {
                        root.expand-clicked();
                    }
                }
            }

            // Close button (macOS / Modern style)
            Rectangle {
                x: parent.width - 36px;
                y: (parent.height - 26px) / 2;
                width: 26px;
                height: 26px;
                border-radius: 13px;
                background: close-touch.pressed 
                    ? Theme.error-border
                    : (close-touch.has-hover ? Theme.secondary : Colors.transparent);

                animate background { duration: 100ms; }

                Path {
                    width: 10px;
                    height: 10px;
                    x: (parent.width - 10px) / 2;
                    y: (parent.height - 10px) / 2;
                    commands: "M 1.5 1.5 L 8.5 8.5 M 8.5 1.5 L 1.5 8.5";
                    stroke: close-touch.has-hover ? (close-touch.pressed ? Theme.error-fg : Theme.foreground-soft) : Theme.muted;
                    stroke-width: 1.5px;
                }
                close-touch := TouchArea {
                    clicked => {
                        root.close-clicked();
                    }
                }
            }

            // Subtle divider line
            Rectangle {
                x: 0px;
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                background: Theme.border-subtle;
            }
        }

        // Main content area
        VerticalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 18px;
            padding-bottom: 18px;
            alignment: stretch;
            vertical-stretch: 1;

            @children
        }
    }

    // Right edge resize handle
    if root.resizable : TouchArea {
        x: parent.width - 8px;
        y: Theme.titlebar-height;
        width: 8px;
        height: parent.height - Theme.titlebar-height - 14px;
        mouse-cursor: ew-resize;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                root.window-resize-started(1);
            }
        }
        moved => {
            root.window-resized(self.mouse-x - self.pressed-x, 0px);
        }
    }

    // Bottom edge resize handle
    if root.resizable : TouchArea {
        x: 0px;
        y: parent.height - 8px;
        width: parent.width - 14px;
        height: 8px;
        mouse-cursor: ns-resize;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                root.window-resize-started(2);
            }
        }
        moved => {
            root.window-resized(0px, self.mouse-y - self.pressed-y);
        }
    }

    // Bottom-right corner resize handle
    if root.resizable : TouchArea {
        x: parent.width - 18px;
        y: parent.height - 18px;
        width: 18px;
        height: 18px;
        mouse-cursor: nwse-resize;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                root.window-resize-started(3);
            }
        }
        moved => {
            root.window-resized(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
        }
    }

    // Visual grip dots in bottom-right corner
    if root.resizable : Rectangle {
        x: parent.width - 12px;
        y: parent.height - 12px;
        width: 8px;
        height: 8px;

        Rectangle {
            x: 5px;
            y: 5px;
            width: 2px;
            height: 2px;
            border-radius: 1px;
            background: Theme.muted;
        }
        Rectangle {
            x: 1px;
            y: 5px;
            width: 2px;
            height: 2px;
            border-radius: 1px;
            background: Theme.muted;
        }
        Rectangle {
            x: 5px;
            y: 1px;
            width: 2px;
            height: 2px;
            border-radius: 1px;
            background: Theme.muted;
        }
    }
}
