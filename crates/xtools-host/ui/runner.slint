import { ToolShell, MultilineEditor, ActionButton, CopyButton, IconButton, ValueInput, FieldWithAction, DropdownSelector, InlineError, InlineNote, Theme } from "@xtools-ui/components.slint";
import { ListView, ScrollView, Slider } from "std-widgets.slint";

export struct TreeNodeItem {
    id: int,
    depth: int,
    key-text: string,
    value-text: string,
    node-type: string,
    summary-text: string,
    is-leaf: bool,
    collapsed: bool,
    has-comma: bool,
}

export struct CodeToken {
    text: string,
    kind: int, // 0 plain, 1 keyword, 2 string, 3 comment, 4 number, 5 type
}

export struct CodeLineItem {
    tokens: [CodeToken],
}

export struct AiSegment {
    is-code: bool,
    text: string,       // 普通文本段
    lang: string,       // 代码段语言标注
    code: string,       // 代码段原文（复制用）
    lines: [CodeLineItem],
}

export struct AiChatMessage {
    role: int, // 0 = user, 1 = assistant
    content: string,
    segments: [AiSegment],
}

export struct AiProviderItem {
    id: string,
    name: string,
    base-url: string,
    api-key: string,
    models: [string],
}

// AI 聊天输入框：上编辑区 + 框内底部「模型选择 / 发送」工具条
component ChatComposer inherits Rectangle {
    in-out property <string> text;
    in property <[string]> model-options;
    in-out property <int> model-index: 0;
    in property <bool> pending;
    callback edited(string);
    callback send-clicked();
    callback model-changed(int);

    height: 96px;
    border-radius: Theme.radius-control;
    border-width: text-input.has-focus ? 1.5px : 1px;
    border-color: text-input.has-focus ? Theme.primary : Theme.border;
    background: Theme.card-bg;
    clip: true;

    animate border-color { duration: 100ms; }

    VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 6px;

        // 编辑区
        Rectangle {
            vertical-stretch: 1;
            clip: true;

            scroll := ScrollView {
                width: 100%;
                height: 100%;
                viewport-width: self.visible-width;
                viewport-height: max(self.visible-height, text-input.preferred-height);

                text-input := TextInput {
                    width: parent.width;
                    single-line: false;
                    wrap: word-wrap;
                    font-size: Theme.font-size-body;
                    color: Theme.foreground;
                    selection-background-color: Theme.selection;
                    selection-foreground-color: Theme.foreground;
                    text <=> root.text;

                    edited => { root.edited(self.text); }
                    key-pressed(event) => {
                        if (event.text == "\n" && !event.modifiers.shift) {
                            root.send-clicked();
                            accept
                        } else {
                            reject
                        }
                    }
                    cursor-position-changed(cpos) => {
                        if (cpos.y + scroll.viewport-y < 0px) {
                            scroll.viewport-y = min(0px, max(scroll.visible-height - self.height, -cpos.y));
                        } else if (cpos.y + scroll.viewport-y > scroll.visible-height - 20px) {
                            scroll.viewport-y = min(0px, max(scroll.visible-height - self.height, scroll.visible-height - cpos.y - 20px));
                        }
                    }
                }
            }

            if root.text == "" : Text {
                x: 0px;
                y: 2px;
                text: "输入问题，Enter 发送，Shift+Enter 换行";
                font-size: Theme.font-size-body;
                color: Theme.muted;
            }
        }

        // 框内底部工具条：模型选择 + 发送（整体缩至 80%，比编辑区更轻量）
        HorizontalLayout {
            spacing: 6px;
            alignment: stretch;

            if root.model-options.length > 0 : DropdownSelector {
                options: root.model-options;
                selected-index <=> root.model-index;
                selector-width: 176px;
                selector-height: Theme.control-height * 0.8;
                open-up: true;
                selection-changed(idx) => { root.model-changed(idx); }
            }

            if root.model-options.length == 0 : Text {
                text: "未配置模型，请到「设置」添加服务商与模型";
                font-size: Theme.font-size-small;
                color: Theme.muted;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }

            if root.model-options.length > 0 : Rectangle { horizontal-stretch: 1; }

            ActionButton {
                // 生成中变为「停止」按钮
                text: root.pending ? "停止" : "发送";
                is-primary: true;
                min-btn-width: 48px;
                btn-height: Theme.control-height * 0.8;
                enabled: root.pending || root.text != "";
                clicked => { root.send-clicked(); }
            }
        }
    }
}

export component RunnerWindow inherits Window {
    title: "xtools";
    no-frame: true;
    background: Colors.transparent;
    default-font-family: "Microsoft YaHei, Segoe UI, PingFang SC, Noto Sans CJK SC, sans-serif";
    min-width: 420px;
    min-height: 320px;
    // 由宿主按 580×600 / 1.5x expanded 写入，避免 preferred 把宽度钉死
    in-out property <int> frame-w: 580;
    in-out property <int> frame-h: 600;
    preferred-width: root.frame-w * 1px;
    preferred-height: root.frame-h * 1px;

    in-out property <string> window-title: "xtools";
    in-out property <string> window-icon: "⚡";
    in-out property <string> plugin-kind: ""; // "time", "json", "trans", "ai", "codec", "generic"
    in-out property <bool> resizable: true;
    in-out property <bool> show-expand-button: true;
    in-out property <bool> is-expanded: false;
    // 窗口整体不透明度（1.0 = 不透明），宿主启动时从偏好文件读入
    in-out property <float> window-opacity: 1.0;
    // Window Management Callbacks
    callback close-clicked();
    callback expand-clicked();
    callback window-drag-started();
    callback window-dragged(length, length);
    callback window-resize-started(int);
    callback window-resized(length, length);
    // Generic Dispatch Callbacks
    callback button-clicked(string);
    callback input-changed(string, string);
    callback select-changed(string, int);
    callback tab-changed(string, int);
    callback tree-toggle-clicked(string, int);

    // Toast State
    in-out property <bool> toast-visible: false;
    in-out property <string> toast-message: "";
    in-out property <bool> toast-is-success: true;

    // -------------------------------------------------------------------------
    // Time Plugin State & Callbacks
    // -------------------------------------------------------------------------
    // Top Card: 当前时间戳实时看板
    in-out property <string> time-now-val: "";
    in-out property <bool> time-now-is-ms: false;
    in-out property <bool> time-now-paused: false;
    in-out property <bool> time-now-copied: false;

    // Tabs: 0 = 单个转换, 1 = 批量转换
    in-out property <int> time-active-tab: 0;

    // Common Timezone options
    in-out property <int> time-tz-index: 0;
    in-out property <[string]> time-tz-options: [];

    // 单个转换：1. 时间戳转日期时间
    in-out property <string> time-ts-input: "";
    in-out property <int> time-ts-unit: 0; // 0 = 秒 (s), 1 = 毫秒 (ms)
    in-out property <int> time-ts-tz-index: 0;
    in-out property <string> time-ts-result: "";
    in-out property <string> time-ts-error: "";
    in-out property <bool> time-ts-copied: false;

    // 单个转换：2. 日期时间转时间戳
    in-out property <string> time-dt-input: "";
    in-out property <int> time-dt-unit: 0; // 0 = 秒 (s), 1 = 毫秒 (ms)
    in-out property <int> time-dt-tz-index: 0;
    in-out property <string> time-dt-result: "";
    in-out property <string> time-dt-error: "";
    in-out property <bool> time-dt-copied: false;

    // 批量转换
    in-out property <int> time-batch-mode: 0; // 0 = 时间戳转日期, 1 = 日期转时间戳
    in-out property <int> time-batch-tz-index: 0;
    in-out property <string> time-batch-input: "";
    in-out property <string> time-batch-result: "";
    in-out property <string> time-batch-error: "";
    in-out property <bool> time-batch-copied: false;

    // Legacy properties kept for compatibility
    in-out property <string> time-seconds: "";
    in-out property <string> time-millis: "";
    in-out property <string> time-local: "";
    in-out property <bool> time-sec-copied: false;
    in-out property <bool> time-ms-copied: false;
    in-out property <bool> time-local-copied: false;
    in-out property <string> time-error-seconds: "";
    in-out property <string> time-error-millis: "";
    in-out property <string> time-error-local: "";

    // Callbacks for Top Card
    callback time-toggle-unit();
    callback time-copy-now();
    callback time-toggle-pause();

    // Callbacks for Ts -> Dt
    callback time-ts-input-edited(string);
    callback time-ts-toggle-unit();
    callback time-ts-tz-changed(int);
    callback time-ts-fill-current();
    callback time-ts-convert();
    callback time-ts-copy();

    // Callbacks for Dt -> Ts
    callback time-dt-input-edited(string);
    callback time-dt-toggle-unit();
    callback time-dt-tz-changed(int);
    callback time-dt-convert();
    callback time-dt-copy();

    // Callbacks for Batch
    callback time-batch-mode-changed(int);
    callback time-batch-tz-changed(int);
    callback time-batch-input-edited(string);
    callback time-batch-convert();
    callback time-batch-copy();
    callback time-batch-clear();
    callback time-tz-changed(int);

    // -------------------------------------------------------------------------
    // JSON Plugin State & Callbacks
    // -------------------------------------------------------------------------
    in-out property <string> json-text: "";
    in-out property <int> json-view-mode: 0; // 0 = Code, 1 = Tree Fold
    in-out property <bool> json-copied: false;
    in-out property <string> json-error: "";
    in-out property <string> json-note: "";
    in-out property <[TreeNodeItem]> json-tree-items: [];

    callback json-format();
    callback json-minify();
    callback json-unescape();
    callback json-validate();
    callback json-clear();
    callback json-copy();
    callback json-mode-switch(int);
    callback json-expand-all();
    callback json-collapse-all();
    callback json-fold-level(int);
    callback json-text-edited(string);
    callback json-tree-toggle(int);

    // -------------------------------------------------------------------------
    // Trans Plugin State & Callbacks
    // -------------------------------------------------------------------------
    in-out property <string> trans-source: "";
    in-out property <string> trans-target: "";
    in-out property <int> trans-src-idx: 0;
    in-out property <int> trans-dst-idx: 0;
    in-out property <int> trans-engine-idx: 0;
    in-out property <[string]> trans-src-options: ["自动", "中文", "英语", "日语", "韩语", "法语", "德语", "西班牙语", "俄语"];
    in-out property <[string]> trans-dst-options: ["中文", "英语", "日语", "韩语", "法语", "德语", "西班牙语", "俄语"];
    in-out property <[string]> trans-engine-options: ["MyMemory (免密钥)", "百度翻译"];
    in-out property <bool> trans-pending: false;
    in-out property <bool> trans-copied: false;
    in-out property <string> trans-error: "";
    in-out property <string> trans-status: "引擎：MyMemory (免密钥)";

    callback trans-translate();
    callback trans-swap();
    callback trans-clear();
    callback trans-copy();
    callback trans-source-edited(string);
    callback trans-src-changed(int);
    callback trans-dst-changed(int);
    callback trans-engine-changed(int);

    // -------------------------------------------------------------------------
    // Codec Plugin State & Callbacks
    // -------------------------------------------------------------------------
    in-out property <string> codec-input: "";
    in-out property <string> codec-output: "";
    in-out property <int> codec-kind-index: 0;
    in-out property <[string]> codec-options: ["Unicode", "UTF-8", "URL", "Hex", "Base64", "大小写"];
    in-out property <bool> codec-copied: false;
    in-out property <string> codec-error: "";
    in-out property <string> codec-status: "Unicode：文本 ↔ \\uXXXX";

    callback codec-encode();
    callback codec-decode();
    callback codec-swap();
    callback codec-clear();
    callback codec-copy();
    callback codec-input-edited(string);
    callback codec-kind-changed(int);

    // -------------------------------------------------------------------------
    // Host Settings View State (tray → 设置)
    // -------------------------------------------------------------------------
    in-out property <string> settings-baidu-appid: "";
    in-out property <string> settings-baidu-key: "";
    // AI 多服务商列表（结构化编辑，自动保存）
    in-out property <[AiProviderItem]> ai-providers: [];
    in-out property <float> settings-opacity-percent: 100;
    in-out property <bool> settings-autosave-visible: false;
    callback opacity-changed(float);
    callback ai-provider-added();
    callback ai-provider-removed(string);
    callback ai-provider-field-changed(string, string, string);
    callback ai-model-added(string);
    callback ai-model-removed(string, string);
    callback ai-new-model-changed(string, string);

    // -------------------------------------------------------------------------
    // AI Plugin State & Callbacks
    // -------------------------------------------------------------------------
    in-out property <[AiChatMessage]> ai-messages: [];
    in-out property <string> ai-input: "";
    in-out property <bool> ai-pending: false;
    in-out property <string> ai-error: "";
    in-out property <string> ai-status: "";
    in-out property <[string]> ai-model-options: [];
    in-out property <int> ai-model-index: 0;
    // 会话列表（多会话切换）
    in-out property <[string]> ai-session-options: [];
    in-out property <int> ai-session-index: 0;
    // 流式生成中：当前已收到的完整回答文本（宿主后台线程增量回填）
    in-out property <string> ai-stream-text: "";

    callback ai-send();
    callback ai-clear();
    callback ai-copy();
    callback ai-input-edited(string);
    callback ai-model-changed(int);
    callback ai-copy-code(string);
    callback ai-session-changed(int);
    callback ai-new-session();

    // -------------------------------------------------------------------------
    // Generic Plugin Fallback State
    // -------------------------------------------------------------------------
    in-out property <string> generic-main-text: "";
    in-out property <string> generic-error-text: "";
    in-out property <string> generic-status-text: "";
    in-out property <int> generic-active-tab: 0;
    in-out property <[string]> generic-tab-labels: [];

    forward-focus: focus-scope;
    focus-scope := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close-clicked();
                return accept;
            }
            if (event.text == "\n" && event.modifiers.control) {
                if (root.plugin-kind == "trans") {
                    root.trans-translate();
                    return accept;
                }
                if (root.plugin-kind == "json") {
                    root.json-format();
                    return accept;
                }
                if (root.plugin-kind == "codec") {
                    root.codec-encode();
                    return accept;
                }
                if (root.plugin-kind == "ai") {
                    root.ai-send();
                    return accept;
                }
            }
            if (event.text == "\n" && !event.modifiers.shift && !event.modifiers.control) {
                if (root.plugin-kind == "trans") {
                    if (!root.trans-pending && root.trans-source != "") {
                        root.trans-translate();
                        return accept;
                    }
                }
            }
            reject
        }
        ToolShell {
            width: 100%;
            height: 100%;
            opacity: root.window-opacity;
            title: root.window-title;
            icon: root.window-icon;
            resizable: root.resizable;
            show-expand-button: root.show-expand-button;
            is-expanded: root.is-expanded;
            close-clicked => { root.close-clicked(); }
            expand-clicked => { root.expand-clicked(); }
            window-drag-started => { root.window-drag-started(); }
            window-dragged(dx, dy) => { root.window-dragged(dx, dy); }
            window-resize-started(edge) => { root.window-resize-started(edge); }
            window-resized(dx, dy) => { root.window-resized(dx, dy); }

            // =================================================================
            // 1. TIME PLUGIN VIEW
            // =================================================================
            if root.plugin-kind == "time" : VerticalLayout {
                spacing: 12px;
                alignment: stretch;
                vertical-stretch: 1;

                // -------------------------------------------------------------
                // A. 当前时间戳卡片 (Header Card)
                // -------------------------------------------------------------
                Rectangle {
                    border-radius: Theme.radius-card;
                    border-width: 1px;
                    border-color: Theme.border;
                    background: Theme.secondary;

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 10px;
                        padding-bottom: 10px;
                        alignment: space-between;

                        // 左侧：标签 + 大号时间戳 + 单位角标
                        VerticalLayout {
                            spacing: 4px;
                            alignment: center;

                            Text {
                                text: "当前时间戳";
                                font-size: Theme.font-size-small;
                                font-weight: 500;
                                color: Theme.muted;
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;

                                Text {
                                    text: root.time-now-val;
                                    font-size: 24px;
                                    font-weight: 700;
                                    font-family: Theme.font-mono;
                                    color: Theme.foreground;
                                    vertical-alignment: center;
                                }

                                Rectangle {
                                    height: 22px;
                                    border-radius: 4px;
                                    background: Theme.success-bg;
                                    border-width: 1px;
                                    border-color: Theme.success-border;

                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        alignment: center;
                                        Text {
                                            text: root.time-now-is-ms ? "毫秒" : "秒";
                                            font-size: 11px;
                                            font-weight: 600;
                                            color: Theme.success;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }

                        // 右侧：切换单位 + 复制 + 暂停/继续
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;

                            ActionButton {
                                text: "🔄 切换单位";
                                min-btn-width: 82px;
                                clicked => { root.time-toggle-unit(); }
                            }

                            ActionButton {
                                text: root.time-now-copied ? "✓ 已复制" : "📋 复制";
                                min-btn-width: 72px;
                                clicked => { root.time-copy-now(); }
                            }

                            ActionButton {
                                variant: root.time-now-paused ? "success" : "danger";
                                text: root.time-now-paused ? "▶ 继续" : "⏹ 暂停";
                                min-btn-width: 72px;
                                clicked => { root.time-toggle-pause(); }
                            }
                        }
                    }
                }

                // -------------------------------------------------------------
                // B. 选项卡：单个转换 / 批量转换 (Tabs)
                // -------------------------------------------------------------
                Rectangle {
                    height: 36px;
                    border-radius: Theme.radius-control;
                    background: Theme.secondary;

                    HorizontalLayout {
                        padding: 3px;
                        spacing: 4px;

                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 6px;
                            background: root.time-active-tab == 0 ? Theme.card-bg : transparent;
                            border-width: root.time-active-tab == 0 ? 1px : 0px;
                            border-color: root.time-active-tab == 0 ? Theme.border : transparent;

                            Text {
                                text: "单个转换";
                                font-size: Theme.font-size-body;
                                font-weight: root.time-active-tab == 0 ? 600 : 500;
                                color: root.time-active-tab == 0 ? Theme.foreground : Theme.muted;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            TouchArea {
                                clicked => { root.time-active-tab = 0; }
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 6px;
                            background: root.time-active-tab == 1 ? Theme.card-bg : transparent;
                            border-width: root.time-active-tab == 1 ? 1px : 0px;
                            border-color: root.time-active-tab == 1 ? Theme.border : transparent;

                            Text {
                                text: "批量转换";
                                font-size: Theme.font-size-body;
                                font-weight: root.time-active-tab == 1 ? 600 : 500;
                                color: root.time-active-tab == 1 ? Theme.foreground : Theme.muted;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            TouchArea {
                                clicked => { root.time-active-tab = 1; }
                            }
                        }
                    }
                }

                // -------------------------------------------------------------
                // C. 转换区域 (根据 Tab 切换)
                // -------------------------------------------------------------
                if root.time-active-tab == 0 : VerticalLayout {
                    spacing: 12px;
                    vertical-stretch: 1;

                    // 1. 时间戳转日期时间 Card
                    VerticalLayout {
                        spacing: 6px;

                        // 标题
                        Text {
                            text: "🕒 时间戳转日期时间";
                            font-size: Theme.font-size-title;
                            font-weight: 600;
                            color: Theme.foreground;
                        }

                        // 输入标签行
                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: "时间戳";
                                font-size: Theme.font-size-small;
                                font-weight: 500;
                                color: Theme.muted;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: "时区";
                                font-size: Theme.font-size-small;
                                font-weight: 500;
                                color: Theme.muted;
                                width: 140px;
                            }
                            Rectangle { width: 156px; }
                        }

                        // 输入与转换操作行
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: stretch;

                            ValueInput {
                                text <=> root.time-ts-input;
                                placeholder: "输入时间戳";
                                input-height: Theme.control-height * 1.2;
                                horizontal-stretch: 1;
                                edited(t) => { root.time-ts-input-edited(t); }
                                accepted(t) => { root.time-ts-convert(); }
                            }

                            ActionButton {
                                text: root.time-ts-unit == 0 ? "秒 (s)" : "毫秒 (ms)";
                                min-btn-width: 68px;
                                clicked => { root.time-ts-toggle-unit(); }
                            }

                            DropdownSelector {
                                options: root.time-tz-options;
                                selected-index <=> root.time-ts-tz-index;
                                selector-width: 140px;
                                selection-changed(idx) => { root.time-ts-tz-changed(idx); }
                            }

                            ActionButton {
                                text: "⚡ 填入当前";
                                min-btn-width: 82px;
                                clicked => { root.time-ts-fill-current(); }
                            }

                            ActionButton {
                                variant: "success";
                                text: "转换";
                                min-btn-width: 66px;
                                clicked => { root.time-ts-convert(); }
                            }
                        }

                        // 结果标签行
                        Text {
                            text: "转换结果";
                            font-size: Theme.font-size-small;
                            font-weight: 500;
                            color: Theme.muted;
                        }

                        // 结果输出行
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: stretch;

                            ValueInput {
                                text <=> root.time-ts-result;
                                placeholder: "转换结果";
                                read-only: true;
                                input-height: Theme.control-height * 1.2;
                                horizontal-stretch: 1;
                            }

                            CopyButton {
                                copied: root.time-ts-copied;
                                enabled: root.time-ts-result != "";
                                clicked => { root.time-ts-copy(); }
                            }
                        }

                        if root.time-ts-error != "" : InlineError {
                            error-text: root.time-ts-error;
                        }
                    }

                    // 分割线
                    Rectangle {
                        height: 1px;
                        background: Theme.border;
                    }

                    // 2. 日期时间转时间戳 Card
                    VerticalLayout {
                        spacing: 6px;

                        // 标题
                        Text {
                            text: "📅 日期时间转时间戳";
                            font-size: Theme.font-size-title;
                            font-weight: 600;
                            color: Theme.foreground;
                        }

                        // 输入标签行
                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: "日期时间";
                                font-size: Theme.font-size-small;
                                font-weight: 500;
                                color: Theme.muted;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: "时区";
                                font-size: Theme.font-size-small;
                                font-weight: 500;
                                color: Theme.muted;
                                width: 140px;
                            }
                            Rectangle { width: 74px; }
                        }

                        // 输入与转换操作行
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: stretch;

                            ValueInput {
                                text <=> root.time-dt-input;
                                placeholder: "YYYY-MM-DD HH:mm:ss";
                                input-height: Theme.control-height * 1.2;
                                horizontal-stretch: 1;
                                edited(t) => { root.time-dt-input-edited(t); }
                                accepted(t) => { root.time-dt-convert(); }
                            }

                            DropdownSelector {
                                options: root.time-tz-options;
                                selected-index <=> root.time-dt-tz-index;
                                selector-width: 140px;
                                selection-changed(idx) => { root.time-dt-tz-changed(idx); }
                            }

                            ActionButton {
                                variant: "success";
                                text: "转换";
                                min-btn-width: 66px;
                                clicked => { root.time-dt-convert(); }
                            }
                        }

                        // 结果标签行
                        Text {
                            text: "转换结果";
                            font-size: Theme.font-size-small;
                            font-weight: 500;
                            color: Theme.muted;
                        }

                        // 结果输出行
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: stretch;

                            ValueInput {
                                text <=> root.time-dt-result;
                                placeholder: "转换结果";
                                read-only: true;
                                input-height: Theme.control-height * 1.2;
                                horizontal-stretch: 1;
                            }

                            ActionButton {
                                text: root.time-dt-unit == 0 ? "秒 (s)" : "毫秒 (ms)";
                                min-btn-width: 68px;
                                clicked => { root.time-dt-toggle-unit(); }
                            }

                            CopyButton {
                                copied: root.time-dt-copied;
                                enabled: root.time-dt-result != "";
                                clicked => { root.time-dt-copy(); }
                            }
                        }

                        if root.time-dt-error != "" : InlineError {
                            error-text: root.time-dt-error;
                        }
                    }
                }

                // 批量转换视图
                if root.time-active-tab == 1 : VerticalLayout {
                    spacing: 10px;
                    vertical-stretch: 1;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: stretch;

                        ActionButton {
                            text: root.time-batch-mode == 0 ? "时间戳 → 日期时间" : "日期时间 → 时间戳";
                            min-btn-width: 140px;
                            clicked => {
                                root.time-batch-mode = root.time-batch-mode == 0 ? 1 : 0;
                                root.time-batch-mode-changed(root.time-batch-mode);
                            }
                        }

                        DropdownSelector {
                            label: "时区：";
                            options: root.time-tz-options;
                            selected-index <=> root.time-batch-tz-index;
                            selector-width: 180px;
                            selection-changed(idx) => { root.time-batch-tz-changed(idx); }
                        }

                        Rectangle { horizontal-stretch: 1; }

                        ActionButton {
                            variant: "success";
                            text: "批量转换";
                            min-btn-width: 80px;
                            clicked => { root.time-batch-convert(); }
                        }

                        ActionButton {
                            text: "🗑 清空";
                            min-btn-width: 66px;
                            clicked => { root.time-batch-clear(); }
                        }
                    }

                    Text {
                        text: root.time-batch-mode == 0 ? "批量输入（每行一个时间戳，支持秒/毫秒）：" : "批量输入（每行一个日期时间）：";
                        font-size: Theme.font-size-small;
                        color: Theme.muted;
                    }

                    MultilineEditor {
                        text <=> root.time-batch-input;
                        height: 110px;
                        edited(t) => { root.time-batch-input-edited(t); }
                    }

                    HorizontalLayout {
                        Text {
                            text: "批量转换结果：";
                            font-size: Theme.font-size-small;
                            color: Theme.muted;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        CopyButton {
                            copied: root.time-batch-copied;
                            enabled: root.time-batch-result != "";
                            clicked => { root.time-batch-copy(); }
                        }
                    }

                    MultilineEditor {
                        text <=> root.time-batch-result;
                        vertical-stretch: 1;
                        read-only: true;
                    }

                    if root.time-batch-error != "" : InlineError {
                        error-text: root.time-batch-error;
                    }
                }
            }

            // =================================================================
            // 2. JSON PLUGIN VIEW
            // =================================================================
            if root.plugin-kind == "json" : VerticalLayout {
                spacing: 10px;
                alignment: stretch;
                vertical-stretch: 1;

                // Mode switcher and toolbar header
                HorizontalLayout {
                    spacing: 8px;
                    alignment: space-between;

                    // Mode switch tabs
                    Rectangle {
                        border-radius: Theme.radius-control;
                        background: Theme.secondary-hover;
                        height: 32px;

                        HorizontalLayout {
                            padding: 2px;
                            spacing: 2px;

                            // Text mode
                            Rectangle {
                                border-radius: Theme.radius-control - 2px;
                                background: root.json-view-mode == 0 ? Theme.card-bg : Colors.transparent;

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    alignment: center;

                                    Text {
                                        text: "📝 源码编辑";
                                        font-size: Theme.font-size-small;
                                        font-weight: root.json-view-mode == 0 ? 600 : 500;
                                        color: root.json-view-mode == 0 ? Theme.foreground : Theme.muted;
                                        vertical-alignment: center;
                                    }
                                }

                                TouchArea {
                                    clicked => { root.json-mode-switch(0); }
                                }
                            }

                            // Tree fold mode
                            Rectangle {
                                border-radius: Theme.radius-control - 2px;
                                background: root.json-view-mode == 1 ? Theme.card-bg : Colors.transparent;

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    alignment: center;

                                    Text {
                                        text: "🌲 树形折叠";
                                        font-size: Theme.font-size-small;
                                        font-weight: root.json-view-mode == 1 ? 600 : 500;
                                        color: root.json-view-mode == 1 ? Theme.primary : Theme.muted;
                                        vertical-alignment: center;
                                    }
                                }

                                TouchArea {
                                    clicked => { root.json-mode-switch(1); }
                                }
                            }
                        }
                    }

                    // Tree mode quick fold tools
                    if root.json-view-mode == 1 : HorizontalLayout {
                        spacing: 6px;
                        alignment: end;

                        ActionButton {
                            text: "全部展开";
                            min-btn-width: 60px;
                            clicked => { root.json-expand-all(); }
                        }

                        ActionButton {
                            text: "全部折叠";
                            min-btn-width: 60px;
                            clicked => { root.json-collapse-all(); }
                        }

                        ActionButton {
                            text: "折叠至2层";
                            min-btn-width: 65px;
                            clicked => { root.json-fold-level(2); }
                        }
                    }
                }

                // Main editor / Tree viewer area
                if root.json-view-mode == 0 : MultilineEditor {
                    text <=> root.json-text;
                    vertical-stretch: 1;
                    edited(t) => { root.json-text-edited(t); }
                }

                if root.json-view-mode == 1 : Rectangle {
                    vertical-stretch: 1;
                    border-radius: Theme.radius-control;
                    border-width: 1px;
                    border-color: Theme.border;
                    background: Theme.card-bg;
                    clip: true;

                    ScrollView {
                        viewport-width: self.width;

                        VerticalLayout {
                            alignment: start;
                            spacing: 1px;
                            padding-top: 6px;
                            padding-bottom: 6px;
                            padding-left: 4px;
                            padding-right: 4px;

                            for item in root.json-tree-items : Rectangle {
                                height: 24px;
                                border-radius: 4px;
                                background: touch.has-hover ? Theme.secondary-hover : Colors.transparent;

                                touch := TouchArea {
                                    clicked => {
                                        if (item.node-type == "object" || item.node-type == "array") {
                                            root.json-tree-toggle(item.id);
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    padding-left: 8px + (item.depth * 16px);
                                    padding-right: 8px;
                                    spacing: 4px;
                                    alignment: start;

                                    if (item.node-type == "object" || item.node-type == "array") : Rectangle {
                                        width: 18px;
                                        height: 18px;
                                        border-radius: 3px;
                                        background: btn-touch.has-hover ? Theme.secondary-hover : Colors.transparent;

                                        VerticalLayout {
                                            alignment: center;
                                            Path {
                                                width: 6px;
                                                height: 6px;
                                                commands: item.collapsed
                                                    ? "M 1.5 0.5 L 5 3 L 1.5 5.5"
                                                    : "M 0.5 1.5 L 3 5 L 5.5 1.5";
                                                stroke: btn-touch.has-hover ? Theme.foreground : Theme.muted;
                                                stroke-width: 1.4px;
                                                stroke-line-cap: round;
                                                stroke-line-join: round;
                                            }
                                        }

                                        btn-touch := TouchArea {
                                            clicked => {
                                                root.json-tree-toggle(item.id);
                                            }
                                        }
                                    }

                                    if (item.node-type != "object" && item.node-type != "array") : Rectangle {
                                        width: 18px;
                                        height: 18px;
                                    }

                                    if item.key-text != "" : Text {
                                        text: item.key-text;
                                        font-family: Theme.font-mono;
                                        font-size: 13px;
                                        font-weight: 600;
                                        color: Theme.syntax-key;
                                        vertical-alignment: center;
                                    }

                                    if item.value-text != "" : Text {
                                        text: item.value-text;
                                        font-family: Theme.font-mono;
                                        font-size: 13px;
                                        color: item.node-type == "string" ? Theme.syntax-string
                                             : item.node-type == "number" ? Theme.syntax-number
                                             : item.node-type == "boolean" ? Theme.syntax-boolean
                                             : item.node-type == "null" ? Theme.syntax-null
                                             : Theme.syntax-text;
                                        font-italic: item.node-type == "null";
                                        vertical-alignment: center;
                                    }

                                    if item.collapsed && (item.node-type == "object" || item.node-type == "array") : Rectangle {
                                        height: 18px;
                                        border-radius: 4px;
                                        background: Theme.secondary;
                                        border-width: 1px;
                                        border-color: Theme.border-hover;

                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            alignment: center;

                                            Text {
                                                text: item.summary-text;
                                                font-size: 11px;
                                                font-weight: 500;
                                                color: Theme.foreground-soft;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    if item.has-comma : Text {
                                        text: ",";
                                        font-family: Theme.font-mono;
                                        font-size: 13px;
                                        color: Theme.muted;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }

                // Error / Note area
                if root.json-error != "" : InlineError {
                    error-text: root.json-error;
                }

                // Action Toolbar at Bottom
                HorizontalLayout {
                    spacing: 8px;
                    alignment: stretch;

                    ActionButton {
                        text: "✨ 格式化";
                        is-primary: true;
                        clicked => { root.json-format(); }
                    }

                    ActionButton {
                        text: "⚡ 压缩";
                        clicked => { root.json-minify(); }
                    }

                    ActionButton {
                        text: "🔓 去转义";
                        clicked => { root.json-unescape(); }
                    }

                    ActionButton {
                        text: "🔍 校验";
                        clicked => { root.json-validate(); }
                    }

                    ActionButton {
                        text: "🗑 清空";
                        clicked => { root.json-clear(); }
                    }

                    if root.json-note != "" : InlineNote {
                        text: root.json-note;
                        horizontal-stretch: 1;
                    }

                    if root.json-note == "" : Rectangle {
                        horizontal-stretch: 1;
                    }

                    CopyButton {
                        copied: root.json-copied;
                        enabled: root.json-text != "";
                        clicked => { root.json-copy(); }
                    }
                }
            }

            // =================================================================
            // 3. TRANS PLUGIN VIEW
            // =================================================================
            if root.plugin-kind == "trans" : VerticalLayout {
                spacing: 8px;
                alignment: stretch;
                vertical-stretch: 1;

                // Top Bar: Section Title + Engine Selector
                HorizontalLayout {
                    spacing: 8px;
                    alignment: space-between;

                    Text {
                        text: "原文 (Source)";
                        font-size: Theme.font-size-small;
                        font-weight: 600;
                        color: Theme.muted;
                        vertical-alignment: center;
                    }

                    HorizontalLayout {
                        spacing: 6px;
                        alignment: end;

                        Text {
                            text: "引擎：";
                            font-size: Theme.font-size-small;
                            font-weight: 500;
                            color: Theme.muted;
                            vertical-alignment: center;
                        }

                        DropdownSelector {
                            options: root.trans-engine-options;
                            selected-index <=> root.trans-engine-idx;
                            selector-width: 140px;
                            selection-changed(idx) => { root.trans-engine-changed(idx); }
                        }
                    }
                }

                MultilineEditor {
                    text <=> root.trans-source;
                    vertical-stretch: 1;
                    enter-sends: true;
                    accepted(text) => {
                        if (!root.trans-pending && text != "") {
                            root.trans-source-edited(text);
                            root.trans-translate();
                        }
                    }
                    edited(t) => { root.trans-source-edited(t); }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: stretch;

                    DropdownSelector {
                        label: "源：";
                        options: root.trans-src-options;
                        selected-index <=> root.trans-src-idx;
                        selector-width: 112px;
                        selection-changed(idx) => { root.trans-src-changed(idx); }
                    }

                    IconButton {
                        icon: "⇄";
                        clicked => { root.trans-swap(); }
                    }

                    DropdownSelector {
                        label: "目标：";
                        options: root.trans-dst-options;
                        selected-index <=> root.trans-dst-idx;
                        selector-width: 112px;
                        selection-changed(idx) => { root.trans-dst-changed(idx); }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    ActionButton {
                        text: root.trans-pending ? "翻译中…" : "翻译";
                        is-primary: true;
                        enabled: !root.trans-pending && root.trans-source != "";
                        clicked => { root.trans-translate(); }
                    }
                }

                Text {
                    text: "译文 (Translation)";
                    font-size: Theme.font-size-small;
                    font-weight: 600;
                    color: Theme.muted;
                }

                MultilineEditor {
                    text <=> root.trans-target;
                    vertical-stretch: 1;
                    read-only: true;
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: stretch;

                    if root.trans-error != "" : InlineError {
                        error-text: root.trans-error;
                        horizontal-stretch: 1;
                    }

                    if root.trans-error == "" : InlineNote {
                        text: root.trans-pending ? "正在翻译…" : root.trans-status;
                        horizontal-stretch: 1;
                    }

                    ActionButton {
                        text: "🗑 清空";
                        clicked => { root.trans-clear(); }
                    }

                    CopyButton {
                        copied: root.trans-copied;
                        enabled: root.trans-target != "";
                        clicked => { root.trans-copy(); }
                    }
                }
            }

            // =================================================================
            // 3b. CODEC PLUGIN VIEW
            // =================================================================
            if root.plugin-kind == "codec" : VerticalLayout {
                spacing: 8px;
                alignment: stretch;
                vertical-stretch: 1;

                // 1. 顶部 6 种编码模式分段控制导航
                Rectangle {
                    border-radius: Theme.radius-control;
                    background: Theme.secondary-hover;
                    height: 34px;

                    HorizontalLayout {
                        padding: 3px;
                        spacing: 3px;

                        for label[idx] in root.codec-options : Rectangle {
                            border-radius: Theme.radius-control - 2px;
                            background: root.codec-kind-index == idx
                                ? Theme.card-bg
                                : (item-touch.has-hover ? Theme.secondary : Colors.transparent);
                            border-width: root.codec-kind-index == idx ? 1px : 0px;
                            border-color: root.codec-kind-index == idx ? Theme.border-subtle : Colors.transparent;
                            horizontal-stretch: 1;

                            animate background { duration: 120ms; }

                            HorizontalLayout {
                                alignment: center;
                                Text {
                                    text: label;
                                    font-size: Theme.font-size-small;
                                    font-weight: root.codec-kind-index == idx ? 600 : 500;
                                    color: root.codec-kind-index == idx
                                        ? Theme.primary
                                        : (item-touch.has-hover ? Theme.foreground : Theme.muted);
                                    vertical-alignment: center;
                                }
                            }

                            item-touch := TouchArea {
                                clicked => { root.codec-kind-changed(idx); }
                            }
                        }
                    }
                }

                // 2. 输入区标题与快捷键提示
                HorizontalLayout {
                    alignment: space-between;

                    Text {
                        text: "输入 (Input)";
                        font-size: Theme.font-size-small;
                        font-weight: 600;
                        color: Theme.muted;
                        vertical-alignment: center;
                    }

                    Text {
                        text: "Ctrl+Enter 快捷转换";
                        font-size: 11px;
                        color: Theme.muted;
                        vertical-alignment: center;
                    }
                }

                MultilineEditor {
                    text <=> root.codec-input;
                    vertical-stretch: 1;
                    edited(t) => { root.codec-input-edited(t); }
                }

                // 3. 转换动作条
                HorizontalLayout {
                    spacing: 8px;
                    alignment: stretch;

                    ActionButton {
                        text: root.codec-kind-index == 5 ? "大写" : "⚡ 编码";
                        is-primary: true;
                        min-btn-width: 76px;
                        enabled: root.codec-input != "";
                        clicked => { root.codec-encode(); }
                    }

                    ActionButton {
                        text: root.codec-kind-index == 5 ? "小写" : "🔓 解码";
                        min-btn-width: 76px;
                        enabled: root.codec-input != "";
                        clicked => { root.codec-decode(); }
                    }

                    IconButton {
                        icon: "⇄";
                        enabled: root.codec-input != "" || root.codec-output != "";
                        clicked => { root.codec-swap(); }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }
                }

                // 4. 输出区标题
                Text {
                    text: "输出 (Output)";
                    font-size: Theme.font-size-small;
                    font-weight: 600;
                    color: Theme.muted;
                    vertical-alignment: center;
                }
                MultilineEditor {
                    text <=> root.codec-output;
                    vertical-stretch: 1;
                    read-only: true;
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: stretch;

                    if root.codec-error != "" : InlineError {
                        error-text: root.codec-error;
                        horizontal-stretch: 1;
                    }

                    if root.codec-error == "" : InlineNote {
                        text: root.codec-status;
                        horizontal-stretch: 1;
                    }

                    ActionButton {
                        text: "🗑 清空";
                        clicked => { root.codec-clear(); }
                    }

                    CopyButton {
                        copied: root.codec-copied;
                        enabled: root.codec-output != "";
                        clicked => { root.codec-copy(); }
                    }
                }
            }

            // =================================================================
            // 4. AI PLUGIN VIEW (chat style)
            // =================================================================
            if root.plugin-kind == "ai" : VerticalLayout {
                spacing: 8px;
                alignment: stretch;
                vertical-stretch: 1;

                // Top Bar: 会话切换 + 新建 + 复制 / 删除
                HorizontalLayout {
                    spacing: 6px;
                    alignment: stretch;

                    if root.ai-session-options.length > 0 : DropdownSelector {
                        options: root.ai-session-options;
                        selected-index <=> root.ai-session-index;
                        selector-width: 280px;
                        selection-changed(idx) => { root.ai-session-changed(idx); }
                    }

                    if root.ai-session-options.length == 0 : Text {
                        text: "AI 对话";
                        font-size: Theme.font-size-small;
                        font-weight: 600;
                        color: Theme.muted;
                        vertical-alignment: center;
                    }

                    Rectangle { horizontal-stretch: 1; }

                    IconButton {
                        icon: "＋";
                        clicked => { root.ai-new-session(); }
                    }
                    IconButton {
                        icon: "📋";
                        clicked => { root.ai-copy(); }
                    }
                    IconButton {
                        icon: "🗑";
                        clicked => { root.ai-clear(); }
                    }
                }

                // Chat Conversation List
                Rectangle {
                    vertical-stretch: 1;

                    // 镜像消息模型用于观察变化：新消息入列 / 清空后滚动到底部
                    property <[AiChatMessage]> observed-messages: root.ai-messages;
                    changed observed-messages => {
                        chat-list.viewport-y = Math.min(0px, chat-list.visible-height - chat-list.viewport-height);
                    }
                    // 流式输出时跟随滚动
                    property <string> observed-stream: root.ai-stream-text;
                    changed observed-stream => {
                        chat-list.viewport-y = Math.min(0px, chat-list.visible-height - chat-list.viewport-height);
                    }

                    chat-list := ListView {
                        width: 100%;
                        height: 100%;

                        for msg in root.ai-messages : HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            padding-top: 4px;
                            padding-bottom: 4px;

                            // 用户消息靠右，助手消息靠左
                            if msg.role == 0 : Rectangle { horizontal-stretch: 1; }

                            Rectangle {
                                max-width: chat-list.width * 0.85;
                                border-radius: 10px;
                                background: msg.role == 0 ? Theme.primary : Theme.card-bg;

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    padding-top: 7px;
                                    padding-bottom: 7px;

                                    VerticalLayout {
                                        spacing: 8px;
                                        alignment: start;

                                        // 无分段（空内容=思考中占位）
                                        if msg.segments.length == 0 : Text {
                                            text: msg.content == "" ? "正在思考…" : msg.content;
                                            font-size: Theme.font-size-body;
                                            font-italic: msg.content == "";
                                            color: msg.role == 0 ? Theme.primary-fg
                                                : (msg.content == "" ? Theme.muted : Theme.foreground);
                                            wrap: word-wrap;
                                        }

                                        for seg in msg.segments : VerticalLayout {
                                            spacing: 0px;

                                            // 普通文本段
                                            if !seg.is-code : Text {
                                                text: seg.text;
                                                font-size: Theme.font-size-body;
                                                color: msg.role == 0 ? Theme.primary-fg : Theme.foreground;
                                                wrap: word-wrap;
                                            }

                                            // 代码段：语言标注 + 复制 + 逐 token 着色
                                            if seg.is-code : Rectangle {
                                                min-width: chat-list.width * 0.5;
                                                border-radius: Theme.radius-control;
                                                background: Theme.code-bg;
                                                border-width: 1px;
                                                border-color: Theme.code-border;
                                                clip: true;

                                                VerticalLayout {
                                                    spacing: 0px;

                                                    HorizontalLayout {
                                                        padding-left: 10px;
                                                        padding-right: 6px;
                                                        padding-top: 4px;
                                                        padding-bottom: 2px;
                                                        spacing: 6px;
                                                        alignment: space-between;

                                                        Text {
                                                            text: seg.lang == "" ? "代码" : seg.lang;
                                                            font-size: 11px;
                                                            font-family: Theme.font-mono;
                                                            color: Theme.muted;
                                                            vertical-alignment: center;
                                                        }

                                                        Rectangle {
                                                            width: 24px;
                                                            height: 20px;
                                                            border-radius: 4px;
                                                            background: code-copy-touch.has-hover ? Theme.secondary-hover : Colors.transparent;

                                                            VerticalLayout {
                                                                alignment: center;
                                                                Path {
                                                                    width: 12px;
                                                                    height: 12px;
                                                                    commands: "M 4 2.5 L 4 1 L 10.5 1 L 10.5 7.5 L 9 7.5 M 1 3.5 L 7.5 3.5 L 7.5 10.5 L 1 10.5 Z";
                                                                    stroke: code-copy-touch.has-hover ? Theme.foreground : Theme.muted;
                                                                    stroke-width: 1.2px;
                                                                    stroke-line-cap: round;
                                                                    stroke-line-join: round;
                                                                }
                                                            }

                                                            code-copy-touch := TouchArea {
                                                                clicked => { root.ai-copy-code(seg.code); }
                                                            }
                                                        }
                                                    }

                                                    // 分隔线
                                                    Rectangle {
                                                        height: 1px;
                                                        background: Theme.code-border;
                                                    }

                                                    ScrollView {
                                                        // 高度随内容自适应；过长时封顶并启用内部滚动
                                                        height: min(code-body.preferred-height, 340px);
                                                        viewport-width: max(self.visible-width, code-body.preferred-width);
                                                        viewport-height: code-body.preferred-height;

                                                        code-body := VerticalLayout {
                                                            padding: 8px;
                                                            spacing: 2px;
                                                            alignment: start;

                                                            for code-line in seg.lines : HorizontalLayout {
                                                                spacing: 0px;
                                                                alignment: start;

                                                                for tok in code-line.tokens : Text {
                                                                    text: tok.text;
                                                                    font-family: Theme.font-mono;
                                                                    font-size: 13px;
                                                                    color: tok.kind == 1 ? Theme.syntax-key
                                                                        : tok.kind == 2 ? Theme.syntax-string
                                                                        : tok.kind == 3 ? Theme.syntax-comment
                                                                        : tok.kind == 4 ? Theme.syntax-number
                                                                        : tok.kind == 5 ? Theme.syntax-boolean
                                                                        : Theme.syntax-text;
                                                                    vertical-alignment: center;
                                                                }
                                                            }

                                                            // 空代码块占位
                                                            if seg.lines.length == 0 : Text {
                                                                text: " ";
                                                                font-family: Theme.font-mono;
                                                                font-size: 13px;
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            if msg.role == 1 : Rectangle { horizontal-stretch: 1; }
                        }
                    }

                    if root.ai-messages.length == 0 && !root.ai-pending : Text {
                        x: 14px;
                        width: parent.width - 28px;
                        y: (parent.height - self.preferred-height) / 2;
                        text: "输入问题后按 Enter 或点击「发送」\n开始新的 AI 对话";
                        font-size: Theme.font-size-small;
                        color: Theme.muted;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }

                // Status / Error Note
                HorizontalLayout {
                    if root.ai-error != "" : InlineError {
                        error-text: root.ai-error;
                        horizontal-stretch: 1;
                    }

                    if root.ai-error == "" : InlineNote {
                        text: root.ai-pending ? "正在请求 AI…" : root.ai-status;
                        horizontal-stretch: 1;
                    }
                }

                // Input Bar: 框内底部「模型选择 + 发送」
                ChatComposer {
                    text <=> root.ai-input;
                    model-options: root.ai-model-options;
                    model-index <=> root.ai-model-index;
                    pending: root.ai-pending;
                    edited(t) => { root.ai-input-edited(t); }
                    send-clicked() => { root.ai-send(); }
                    model-changed(idx) => { root.ai-model-changed(idx); }
                }
            }

            // =================================================================
            // 5. HOST SETTINGS VIEW (tray → 设置)
            // =================================================================
            if root.plugin-kind == "settings" : Rectangle {
                vertical-stretch: 1;

                ScrollView {
                    width: 100%;
                    height: 100%;
                    viewport-width: self.visible-width;
                    // 视口高度取内容首选高度：各卡片自上而下排列，不随窗口高度拉伸
                    viewport-height: settings-page.preferred-height;

                    settings-page := VerticalLayout {
                        spacing: 14px;
                        alignment: start;

                        // 隐私说明：全部配置只写本地，不经任何服务器
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;

                            VerticalLayout {
                                alignment: center;
                                Path {
                                    width: 10px;
                                    height: 12px;
                                    commands: "M 2.5 4.5 L 2.5 2.5 C 2.5 1.2 3.5 0.5 5 0.5 C 6.5 0.5 7.5 1.2 7.5 2.5 L 7.5 4.5 M 0.5 4.5 L 9.5 4.5 L 9.5 11.5 L 0.5 11.5 Z M 5 6.5 L 5 8.5";
                                    stroke: Theme.muted;
                                    stroke-width: 1.2px;
                                    stroke-line-cap: round;
                                    stroke-line-join: round;
                                }
                            }

                            Text {
                                text: "所有配置与 API Key 仅保存在本机（本地数据库），不会上传到任何服务器";
                                font-size: Theme.font-size-small;
                                color: Theme.muted;
                                vertical-alignment: center;
                            }
                        }

                        // 百度翻译 API Card（单行紧凑：标题 + AppID + 密钥）
                        Rectangle {
                            border-radius: Theme.radius-control;
                            border-width: 1px;
                            border-color: Theme.border;
                            background: Theme.card-bg;

                            HorizontalLayout {
                                padding: 14px;
                                spacing: 10px;

                                Text {
                                    text: "🔑 百度翻译 API";
                                    font-size: Theme.font-size-small;
                                    font-weight: 600;
                                    color: Theme.foreground;
                                    vertical-alignment: center;
                                }

                                ValueInput {
                                    placeholder: "App ID";
                                    text <=> root.settings-baidu-appid;
                                    horizontal-stretch: 1;
                                    edited(t) => { root.input-changed("settings_baidu_appid", t); }
                                }

                                ValueInput {
                                    placeholder: "密钥 (Secret Key)";
                                    text <=> root.settings-baidu-key;
                                    horizontal-stretch: 1;
                                    edited(t) => { root.input-changed("settings_baidu_key", t); }
                                }
                            }
                        }

                        // AI Service Card（多服务商 / 多模型）
                        Rectangle {
                            border-radius: Theme.radius-control;
                            border-width: 1px;
                            border-color: Theme.border;
                            background: Theme.card-bg;

                            VerticalLayout {
                                padding: 14px;
                                spacing: 10px;

                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: stretch;

                                    VerticalLayout {
                                        spacing: 8px;
                                        horizontal-stretch: 1;

                                        Text {
                                            text: "🤖 AI 服务（OpenAI 兼容接口）";
                                            font-size: Theme.font-size-small;
                                            font-weight: 600;
                                            color: Theme.foreground;
                                            vertical-alignment: center;
                                        }

                                        Text {
                                            text: "可添加多个服务商，每个服务商可配置多个模型；在「AI 问答」输入框底部可切换模型";
                                            font-size: Theme.font-size-small;
                                            color: Theme.muted;
                                            wrap: word-wrap;
                                        }
                                    }

                                    ActionButton {
                                        text: "＋ 添加服务商";
                                        is-primary: true;
                                        clicked => { root.ai-provider-added(); }
                                    }
                                }

                                if root.ai-providers.length == 0 : Text {
                                    text: "还没有服务商，点击右上角「＋ 添加服务商」开始配置";
                                    font-size: Theme.font-size-small;
                                    color: Theme.muted;
                                }

                                for p in root.ai-providers : Rectangle {
                                    border-radius: Theme.radius-control;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    background: Theme.secondary;

                                    VerticalLayout {
                                        padding: 12px;
                                        spacing: 10px;

                                        // 第一行：名称 + 删除
                                        HorizontalLayout {
                                            spacing: 8px;
                                            alignment: stretch;

                                            ValueInput {
                                                placeholder: "服务商名称";
                                                text: p.name;
                                                horizontal-stretch: 1;
                                                edited(t) => { root.ai-provider-field-changed(p.id, "name", t); }
                                            }

                                            IconButton {
                                                icon: "🗑";
                                                clicked => { root.ai-provider-removed(p.id); }
                                            }
                                        }

                                        // 第二行：接口地址（整行）
                                        ValueInput {
                                            placeholder: "接口地址 (Base URL)，如 https://api.deepseek.com/v1";
                                            text: p.base-url;
                                            edited(t) => { root.ai-provider-field-changed(p.id, "base_url", t); }
                                        }

                                        // 第三行：密钥（整行）
                                        ValueInput {
                                            placeholder: "API Key";
                                            text: p.api-key;
                                            edited(t) => { root.ai-provider-field-changed(p.id, "api_key", t); }
                                        }

                                        // 第四行：模型 chips + 添加
                                        HorizontalLayout {
                                            spacing: 8px;
                                            alignment: stretch;

                                            Text {
                                                text: "模型";
                                                font-size: Theme.font-size-small;
                                                color: Theme.muted;
                                                vertical-alignment: center;
                                            }

                                            // 模型 chips（过多时横向滚动）
                                            ScrollView {
                                                horizontal-stretch: 1;
                                                height: 30px;
                                                viewport-width: max(self.visible-width, chips-row.preferred-width);

                                                chips-row := HorizontalLayout {
                                                    spacing: 6px;
                                                    alignment: start;

                                                    for m in p.models : Rectangle {
                                                        height: 26px;
                                                        border-radius: 13px;
                                                        background: Theme.card-bg;
                                                        border-width: 1px;
                                                        border-color: Theme.border;

                                                        HorizontalLayout {
                                                            padding-left: 10px;
                                                            padding-right: 4px;
                                                            spacing: 4px;
                                                            alignment: center;

                                                            Text {
                                                                text: m;
                                                                font-size: Theme.font-size-small;
                                                                font-family: Theme.font-mono;
                                                                color: Theme.foreground;
                                                                vertical-alignment: center;
                                                            }

                                                            Rectangle {
                                                                width: 18px;
                                                                height: 18px;
                                                                border-radius: 9px;
                                                                background: chip-touch.has-hover ? Theme.error-bg : Colors.transparent;

                                                                Text {
                                                                    text: "×";
                                                                    font-size: Theme.font-size-body;
                                                                    font-weight: 600;
                                                                    color: chip-touch.has-hover ? Theme.error-fg : Theme.muted;
                                                                    vertical-alignment: center;
                                                                    horizontal-alignment: center;
                                                                }

                                                                chip-touch := TouchArea {
                                                                    clicked => { root.ai-model-removed(p.id, m); }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }

                                            ValueInput {
                                                placeholder: "模型名";
                                                width: 180px;
                                                edited(t) => { root.ai-new-model-changed(p.id, t); }
                                                accepted(t) => { root.ai-model-added(p.id); }
                                            }

                                            ActionButton {
                                                text: "＋";
                                                min-btn-width: 36px;
                                                clicked => { root.ai-model-added(p.id); }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Window Appearance Card
                        Rectangle {
                            border-radius: Theme.radius-control;
                            border-width: 1px;
                            border-color: Theme.border;
                            background: Theme.card-bg;

                            VerticalLayout {
                                padding: 14px;
                                spacing: 8px;

                                Text {
                                    text: "🪟 窗口外观";
                                    font-size: Theme.font-size-small;
                                    font-weight: 600;
                                    color: Theme.foreground;
                                    vertical-alignment: center;
                                }

                                HorizontalLayout {
                                    spacing: 12px;
                                    Text {
                                        text: "窗口透明度";
                                        font-size: Theme.font-size-small;
                                        color: Theme.muted;
                                        vertical-alignment: center;
                                    }

                                    Slider {
                                        minimum: 30;
                                        maximum: 100;
                                        step: 5;
                                        value <=> root.settings-opacity-percent;
                                        horizontal-stretch: 1;
                                        changed(value) => {
                                            root.window-opacity = value / 100;
                                            root.opacity-changed(value);
                                        }
                                    }

                                    Text {
                                        text: Math.floor(root.settings-opacity-percent + 0.5) + "%";
                                        min-width: 44px;
                                        font-size: Theme.font-size-small;
                                        font-weight: 600;
                                        font-family: Theme.font-mono;
                                        color: Theme.foreground;
                                        vertical-alignment: center;
                                        horizontal-alignment: right;
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            if root.settings-autosave-visible : Text {
                                text: "✓ 已自动保存";
                                font-size: Theme.font-size-small;
                                font-weight: 600;
                                color: Theme.success;
                                vertical-alignment: center;
                            }

                            Rectangle { horizontal-stretch: 1; }

                            InlineNote {
                                text: "输入后自动保存，重新打开对应工具生效";
                            }
                        }
                    }
                }
            }

            // =================================================================
            // 6. GENERIC / DYNAMIC PLUGIN FALLBACK VIEW
            if root.plugin-kind == "generic" : VerticalLayout {
                spacing: 12px;
                alignment: stretch;
                vertical-stretch: 1;
                if root.generic-tab-labels.length > 0 : HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    for label[idx] in root.generic-tab-labels : Rectangle {
                        height: 32px;
                        min-width: 80px;
                        border-radius: Theme.radius-control;
                        background: root.generic-active-tab == idx ? Theme.primary : Theme.secondary;
                        border-width: 1px;
                        border-color: root.generic-active-tab == idx ? Theme.primary-hover : Theme.border;

                        Text {
                            text: label;
                            color: root.generic-active-tab == idx ? Theme.primary-fg : Theme.foreground;
                            font-size: Theme.font-size-body;
                            font-weight: root.generic-active-tab == idx ? 600 : 500;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }

                        TouchArea {
                            clicked => {
                                root.generic-active-tab = idx;
                                root.tab-changed("tabs", idx);
                            }
                        }
                    }
                }

                MultilineEditor {
                    text <=> root.generic-main-text;
                    vertical-stretch: 1;
                    edited(t) => {
                        root.input-changed("main_input", t);
                    }
                }

                if root.generic-error-text != "" : InlineError {
                    error-text: root.generic-error-text;
                }

                if root.generic-status-text != "" : Text {
                    text: root.generic-status-text;
                    color: Theme.muted;
                    font-size: Theme.font-size-small;
                }
            }
        }

        // Floating Toast Notification
        if root.toast-visible : Rectangle {
            x: (parent.width - 200px) / 2;
            y: parent.height - 60px;
            width: 200px;
            height: 36px;
            border-radius: 18px;
            background: root.toast-is-success ? Theme.success-bg : Theme.error-bg;
            border-width: 1px;
            border-color: root.toast-is-success ? Theme.success-border : Theme.error-border;
            drop-shadow-blur: 8px;
            drop-shadow-color: Theme.drop-shadow;

            HorizontalLayout {
                alignment: center;
                spacing: 6px;

                if root.toast-is-success : VerticalLayout {
                    alignment: center;
                    Path {
                        width: 10px;
                        height: 8px;
                        commands: "M 1 4 L 3.5 6.5 L 9 1";
                        stroke: Theme.success;
                        stroke-width: 1.8px;
                        stroke-line-cap: round;
                        stroke-line-join: round;
                    }
                }

                if !root.toast-is-success : VerticalLayout {
                    alignment: center;
                    Path {
                        width: 13px;
                        height: 12px;
                        commands: "M 6.5 1 L 12.5 11.5 L 0.5 11.5 Z M 6.5 4.5 L 6.5 7.5 M 6.5 9.5 L 6.5 10";
                        stroke: Theme.error-fg;
                        stroke-width: 1.2px;
                        stroke-line-cap: round;
                        stroke-line-join: round;
                    }
                }

                Text {
                    text: root.toast-message;
                    font-size: Theme.font-size-body;
                    font-weight: 600;
                    color: root.toast-is-success ? Theme.success : Theme.error-fg;
                    vertical-alignment: center;
                }
            }
        }
    }
}
